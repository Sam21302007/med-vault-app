# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medcare?retryWrites=true&w=majority

# JWT secret for auth tokens (use a long random string in production)
JWT_SECRET=your_secure_jwt_secret_here

# Backend server port (local dev)
PORT=5000

# Frontend API URL (used by React app)
# Local dev:
REACT_APP_API_URL=http://localhost:5000/api
# Production (after deploying backend to Render/Railway):
# REACT_APP_API_URL=https://your-backend.onrender.com/api
