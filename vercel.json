{
  "buildCommand": "cd my-app && npm run build",
  "installCommand": "cd my-app && npm install --legacy-peer-deps",
  "outputDirectory": "my-app/build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/my-app/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
